# ===== Yulda — Environment Configuration =====
# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENV=development
DEBUG=true

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=yulda

# --- Redis ---
# Use 127.0.0.1 rather than localhost — on Windows, async Redis clients can
# stall resolving "localhost" and silently time out.
REDIS_URL=redis://127.0.0.1:6379/0

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Object storage (S3-compatible) ---
# Local dev default points at MinIO. For production, use Cloudflare R2:
#   STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY = R2 API token (R2 > Manage API Tokens)
#   STORAGE_PUBLIC_BASE_URL = your R2 public bucket URL or custom domain
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=yulda-dev
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/yulda-dev

# --- Cloudflare Turnstile (bot verification on signup) ---
# Get keys from the Cloudflare dashboard: Turnstile > Add site
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# --- Maps ---
MAPS_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000
VITE_MAPS_API_KEY=
VITE_TURNSTILE_SITE_KEY=
